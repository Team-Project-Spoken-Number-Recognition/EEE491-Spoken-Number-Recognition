# Normalise text files; Vivado/MATLAB/VHDL work fine with LF in the repo.
* text=auto

*.vhd   text eol=lf
*.vhdl  text eol=lf
*.xdc   text eol=lf
*.tcl   text eol=lf
*.coe   text eol=lf
*.m     text eol=lf
*.md    text eol=lf
*.xci   text eol=lf

# Binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.mat   binary
*.fig   binary
*.slx   binary
*.asc   text
*.wav   binary
*.bit   binary
